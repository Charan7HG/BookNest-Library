# Backend environment variables
# Copy these values into your shell environment before starting the backend.
# Spring Boot does not load .env files automatically.
DB_URL=jdbc:postgresql://localhost:5432/Library
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_your_database_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Optional. Hosting platforms usually inject PORT automatically.
PORT=8080

# Frontend environment variables
# For Vite, configure in library-frontend/.env or your deployment environment:
VITE_API_BASE_URL=http://localhost:8080
